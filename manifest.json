{
  "manifest_version": 3,
  "name": "Crossword Pencil Toggle",
  "version": "1.0",

  "description": "Toggle NYT crossword pencil mode.",

  "icons": {
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "crosswordpenciltoggle@mozilla.org",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.nytimes.com/crosswords/game/daily/*"],
      "js": ["src/pencil.js"],
      "run_at": "document_idle"
    }
  ]
}
